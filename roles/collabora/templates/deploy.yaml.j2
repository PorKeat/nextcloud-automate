---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: collabora
  labels:
    app: collabora
spec:
  replicas: 1
  selector:
    matchLabels:
      app: collabora
  template:
    metadata:
      labels:
        app: collabora
    spec:
      containers:
      - name: collabora
        image: collabora/code:latest
        env:
        - name: extra_params
          value: "--o:ssl.enable=false --o:ssl.termination=true"
        - name: aliasgroup1
          value: "https://nextcloud.sengporkeat.com"
        ports:
        - containerPort: 9980
---
apiVersion: v1
kind: Service
metadata:
  name: collabora
spec:
  selector:
    app: collabora
  ports:
    - protocol: TCP
      port: 9980
      targetPort: 9980
---
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: letsencrypt-collabora
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: admin@sengporkeat.com
    privateKeySecretRef:
      name: letsencrypt-collabora-account-key
    solvers:
    - http01:
        ingress:
          class: traefik
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: collabora
  annotations:
    cert-manager.io/issuer: "letsencrypt-collabora"
spec:
  ingressClassName: traefik
  tls:
  - hosts:
    - office-collabora.sengporkeat.com
    secretName: collabora-tls
  rules:
  - host: office-collabora.sengporkeat.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: collabora
            port:
              number: 9980
